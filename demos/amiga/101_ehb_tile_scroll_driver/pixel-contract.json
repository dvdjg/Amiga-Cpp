{
  "version": 1,
  "viewport": {
    "mode": "auto_non_black",
    "threshold": 8
  },
  "defaults": {
    "rgbTolerance": 8,
    "maxErrorRatio": 0.02
  },
  "globalChecks": [
    {
      "name": "no-inner-black",
      "type": "forbidden_color_ratio",
      "color": [0, 0, 0],
      "colorTolerance": 0,
      "maxRatio": 0.001,
      "roi": { "x": 0, "y": 0, "w": 320, "h": 256 }
    }
  ],
  "segments": [
    {
      "name": "fine-scroll-left",
      "frames": [0, -1],
      "checks": [
        {
          "name": "telemetry-direction-main-roi",
          "type": "telemetry_direction_match",
          "roi": { "x": 24, "y": 24, "w": 272, "h": 208 },
          "cameraXToContentDx": 1,
          "cameraYToContentDy": -1,
          "rgbTolerance": 10,
          "searchRadius": 8,
          "minCompatibleRatio": 0.65
        }
      ]
    }
  ]
}
