# -O3 -fno-tree-vectorize: el render del TU de la demo es sensible al codegen (DT-038/DT-040);
# a -O2 el codigo actual renderiza la sala partida (captura congelada a pan 0, DT-041-nota).
# No quitar -fno-tree-vectorize sin repetir la comprobacion visual con captura congelada.
DEMO_OPT=-O3
DEMO_FLAGS=-fno-tree-vectorize
