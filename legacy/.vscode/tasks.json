{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "compile",
            "type": "shell",
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe",
                "options": {
                    "shell": {
                        "executable": "C:\\Windows\\System32\\cmd.exe",
                        "args": ["/d", "/c"]
                    },
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "AMIGA_BIN_PATH": "${command:amiga.bin-path}",
                        "PATH": "${env:PATH};${command:amiga.bin-path}\\opt\\bin;${command:amiga.bin-path}"
                    }
                }
            },
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}",
                    "AMIGA_BIN_PATH": "${command:amiga.bin-path}"
                }
            },
            "args": [
                "-j1"
            ],
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "compile (debug)",
            "type": "shell",
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe",
                "options": {
                    "shell": {
                        "executable": "C:\\Windows\\System32\\cmd.exe",
                        "args": ["/d", "/c"]
                    },
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "AMIGA_BIN_PATH": "${command:amiga.bin-path}",
                        "PATH": "${env:PATH};${command:amiga.bin-path}\\opt\\bin;${command:amiga.bin-path}"
                    }
                }
            },
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "PATH": "${env:PATH}:${command:amiga.bin-path}/opt/bin:${command:amiga.bin-path}",
                    "AMIGA_BIN_PATH": "${command:amiga.bin-path}"
                }
            },
            "args": [
                "-j1",
                "debug"
            ],
            "problemMatcher": {
                "owner": "cpp",
                "fileLocation": ["relative", "${workspaceFolder}"],
                "pattern": {
                    "regexp": "^(.*):(\\d+):(\\d+):\\s+(warning|error):\\s+(.*)$",
                    "file": 1,
                    "line": 2,
                    "column": 3,
                    "severity": 4,
                    "message": 5
                }
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false,
                "clear": true
            },
            "group": "build"
        },
        {
            "label": "clean",
            "type": "shell",
            "windows": {
                "command": "${command:amiga.bin-path}\\gnumake.exe",
                "options": {
                    "shell": {
                        "executable": "C:\\Windows\\System32\\cmd.exe",
                        "args": ["/d", "/c"]
                    },
                    "cwd": "${workspaceFolder}",
                    "env": {
                        "AMIGA_BIN_PATH": "${command:amiga.bin-path}"
                    }
                }
            },
            "command": "make",
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "AMIGA_BIN_PATH": "${command:amiga.bin-path}"
                }
            },
            "args": [
                "clean"
            ],
            "problemMatcher": []
        }
    ]
}
